# Copia este archivo como .env y completa los valores
# cp .env.example .env

# Clave para desencriptar propiedades cifradas con Jasypt (ver ENCRYPTION_GUIDE.md)
JASYPT_ENCRYPTOR_PASSWORD=

# Perfil de Spring Boot: usar "local" para desarrollo, "prod" para producción
SPRING_PROFILES_ACTIVE=local

# Storage de archivos: usar "local" para upload-local o "s3" para AWS S3
KINGSTORE_STORAGE_PROVIDER=local

# AWS S3: requeridas cuando KINGSTORE_STORAGE_PROVIDER=s3 fuera de EC2/IAM Role
AWS_S3_BUCKET_NAME=kingstore-assets-563688183512-us-east-1-an
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Clave para firmar tokens JWT
JWT_SECRET=

# Contraseña de RDS (opcional: si no se define, se usa el valor cifrado en application.properties)
SPRING_DATASOURCE_PASSWORD=

# Frontend y CORS
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGIN_PATTERNS=http://100.57.218.181,http://100.57.218.181:*,https://ec2-100-57-218-181.compute-1.amazonaws.com,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Recuperacion de contrasena con Gmail
MAIL_USERNAME=cuenta-del-proyecto@gmail.com
MAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
PASSWORD_RESET_EXPIRATION_MINUTES=30
